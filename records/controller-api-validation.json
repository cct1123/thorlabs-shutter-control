{
  "test": "TEST-103",
  "scope": "Software-only existing FakeDevice/virtual clock. Each method starts independently connected Closed/Inactive/Manual, polling 250 ms, first feedback success. Excludes SDK/USB/physical latency.",
  "results": [
    {
      "method": "get_status",
      "expected_programmed_sleep_s": 0.25,
      "observed_programmed_sleep_s": 0.25,
      "expected_request_method_calls": 4,
      "observed_request_method_calls": 4,
      "sdk_method_counts": {
        "status": 1,
        "request_mode": 1,
        "request_operation": 1,
        "request_triggers": 1,
        "get_triggers": 1
      },
      "result": "PASS"
    },
    {
      "method": "get_operating_status",
      "expected_programmed_sleep_s": 0.25,
      "observed_programmed_sleep_s": 0.25,
      "expected_request_method_calls": 3,
      "observed_request_method_calls": 3,
      "sdk_method_counts": {
        "status": 1,
        "request_mode": 1,
        "request_operation": 1
      },
      "result": "PASS"
    },
    {
      "method": "get_trigger_config",
      "expected_programmed_sleep_s": 0.25,
      "observed_programmed_sleep_s": 0.25,
      "expected_request_method_calls": 1,
      "observed_request_method_calls": 1,
      "sdk_method_counts": {
        "request_triggers": 1,
        "get_triggers": 1
      },
      "result": "PASS"
    },
    {
      "method": "get_cached_status",
      "expected_programmed_sleep_s": 0,
      "observed_programmed_sleep_s": 0.0,
      "expected_request_method_calls": 0,
      "observed_request_method_calls": 0,
      "sdk_method_counts": {},
      "result": "PASS"
    },
    {
      "method": "configure_triggers",
      "expected_programmed_sleep_s": 0.5,
      "observed_programmed_sleep_s": 0.5,
      "expected_request_method_calls": 4,
      "observed_request_method_calls": 4,
      "sdk_method_counts": {
        "status": 1,
        "request_mode": 1,
        "request_operation": 1,
        "set_triggers": 1,
        "request_triggers": 1,
        "get_triggers": 1
      },
      "result": "PASS"
    },
    {
      "method": "arm_triggers",
      "expected_programmed_sleep_s": 0.5,
      "observed_programmed_sleep_s": 0.5,
      "expected_request_method_calls": 8,
      "observed_request_method_calls": 8,
      "sdk_method_counts": {
        "status": 2,
        "request_mode": 2,
        "request_operation": 2,
        "request_triggers": 2,
        "get_triggers": 2,
        "enable": 1,
        "set_mode": 1,
        "set_state": 1
      },
      "result": "PASS"
    },
    {
      "method": "open_shutter",
      "expected_programmed_sleep_s": 0.5,
      "observed_programmed_sleep_s": 0.5,
      "expected_request_method_calls": 6,
      "observed_request_method_calls": 6,
      "sdk_method_counts": {
        "status": 2,
        "request_mode": 2,
        "request_operation": 2,
        "enable": 1,
        "set_state": 1
      },
      "result": "PASS"
    },
    {
      "method": "close_shutter",
      "expected_programmed_sleep_s": 0.25,
      "observed_programmed_sleep_s": 0.25,
      "expected_request_method_calls": 3,
      "observed_request_method_calls": 3,
      "sdk_method_counts": {
        "set_state": 1,
        "status": 1,
        "request_mode": 1,
        "request_operation": 1
      },
      "result": "PASS"
    }
  ]
}
